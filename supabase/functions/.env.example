# Copy to .env for local `supabase functions serve`, or set each of these
# with `supabase secrets set` per project when deploying to a real
# business's Supabase project. Onboarding a new business = a new Supabase
# project with its own copy of these values; no code changes.

# Set automatically by the Supabase platform in deployed functions --
# only needed here for local dev.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Used by the agent's tool-calling step (see supabase/functions/operations/agentClient.ts)
ANTHROPIC_API_KEY=

# Used to send shift-offer and escalation emails (see supabase/functions/operations/email.ts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ops@yourbusiness.com

# Operations agent, tenant-specific tuning
OPERATIONS_ESCALATION_EMAIL=info@completestaffing.org
OPERATIONS_OFFER_WINDOW_MINUTES=30
OPERATIONS_ESCALATION_HOURS=4
# Optional override if the project's public URL differs from SUPABASE_URL
# (e.g. a custom domain in front of the function).
OPERATIONS_PUBLIC_URL=

# Recruiter SMS for the public job-board quick-apply intake
# (see supabase/functions/applications/sms.ts). If any of the four is unset,
# the application is still saved -- the SMS is just skipped and logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Where new-applicant texts go (the on-call recruiter's mobile).
APPLICATIONS_RECRUITER_SMS=+1XXXXXXXXXX
